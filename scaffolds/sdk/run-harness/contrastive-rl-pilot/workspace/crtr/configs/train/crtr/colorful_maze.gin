run.seed = 0
run.job_class = @TrainJob
TrainJob.train_steps = 500000000
TrainJob.batch_size = 512
TrainJob.dataset_class = @ContrastiveDatasetDiffLen
    ContrastiveDatasetDiffLen.double_batch = 2
    ContrastiveDatasetDiffLen.path = 'training_datasets/colorful_maze'
    ContrastiveDatasetDiffLen.max_horizon = 200

TrainJob.metric = 'l2'
# Match Ben/ICLR CRTR training loss: exclude the positive diagonal from the
# uniformity term. With exclude_diagonal=False (the code default) the x64-weighted
# l_unif repels each state from its OWN future, corrupting the geometry enough to
# break pure-greedy eval (solves with search, fails greedy).
contrastive_loss.exclude_diagonal = True
contrastive_loss.loss_type = 'backward'
TrainJob.search_shuffles = [6]
TrainJob.lr = 3e-4
TrainJob.solving_interval = 10000
TrainJob.test_path = 'training_datasets/colorful_maze'
TrainJob.model_type = @LNConvNet
    LNConvNet.input_size = 1
    LNConvNet.repr_dim = 64
    LNConvNet.hidden_size = 64
    LNConvNet.depth = 8

TrainJob.eval_job_class = @SolveJob
    SolveJob.n_actions = 1
    SolveJob.solver_class = @BestFSSolver
        BestFSSolver.goal_builder_class = @TrivialPolicy
            TrivialPolicy.env = @ColorfulMazeEnv
            ColorfulMazeEnv.targets = 3
            ColorfulMazeEnv.size = 10

        BestFSSolver.max_tree_size = 50000
        BestFSSolver.max_tree_depth = -1
        BestFSSolver.value_estimator_class = @ValueEstimator

    SolveJob.n_jobs = 200
    SolveJob.n_parallel_workers = 1
    SolveJob.batch_size = 200
    SolveJob.budget_checkpoints = [50, 100, 500, 1000]
    SolveJob.generate_problems = @generate_problems_colorful_maze
