run.seed = 0
run.job_class = @TrainJob
TrainJob.train_steps = 500000000
TrainJob.batch_size = 512
TrainJob.dataset_class = @ContrastiveDataset
    ContrastiveDataset.double_batch = 2
    ContrastiveDataset.gamma = 0.9
    ContrastiveDataset.max_horizon = 200
    ContrastiveDataset.sampling_probability = 'uniform'
    ContrastiveDataset.path = 'training_datasets/lights_out'

# Match Ben loving_raman CRTR (not-removing-positives-from-uniform-loss).
TrainJob.metric = 'l22'
contrastive_loss.exclude_diagonal = False
contrastive_loss.loss_type = 'symmetric'
TrainJob.search_shuffles = [-1]
TrainJob.lr = 1e-4
TrainJob.solving_interval = 150000
TrainJob.test_path = 'training_datasets/lights_out'
TrainJob.model_type = @LNConvNet
    LNConvNet.input_size = 1
    LNConvNet.repr_dim = 64
    LNConvNet.hidden_size = 64
    LNConvNet.depth = 8

TrainJob.eval_job_class = @SolveJob
    # Ben/ICLR Lights Out CRTR in-training eval uses search n_actions=10.
    SolveJob.n_actions = 10
    SolveJob.solver_class = @BestFSSolver
        BestFSSolver.goal_builder_class = @TrivialPolicy
            TrivialPolicy.env = @LightsOut
            LightsOut.n = 7

        BestFSSolver.max_tree_size = 6000
        BestFSSolver.max_tree_depth = -1
        BestFSSolver.value_estimator_class = @ValueEstimator

    SolveJob.n_jobs = 200
    SolveJob.n_parallel_workers = 1
    SolveJob.batch_size = 200
    SolveJob.budget_checkpoints = [50, 75, 100, 500, 1000]
    SolveJob.generate_problems = @generate_problems_lights_out
