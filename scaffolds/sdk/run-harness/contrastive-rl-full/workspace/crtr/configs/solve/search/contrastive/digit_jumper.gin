run.seed = 0
run.job_class = @SolveJob
    SolveJob.n_actions = 4
    SolveJob.generate_problems = @generate_problems_digit_jumper
    SolveJob.shuffles = 100
    SolveJob.metric = 'l2'

    SolveJob.network = @LNDenseNet()
    LNDenseNet.input_size = 400
    LNDenseNet.repr_dim = 64
    LNDenseNet.hidden_size = 1024
    LNDenseNet.depth = 8

    SolveJob.solver_class = @BestFSSolver
    BestFSSolver.goal_builder_class = @TrivialPolicy
        TrivialPolicy.env = @DigitJumper
        DigitJumper.n = 20

    BestFSSolver.max_tree_size = 6000
    BestFSSolver.max_tree_depth = -1
    BestFSSolver.value_estimator_class = @ValueEstimator
    BestFSSolver.checkpoint_path = 'example_checkpoints/digit_jumper/crtr.pt'

    SolveJob.n_jobs = 200
    SolveJob.n_parallel_workers = 1
    SolveJob.batch_size = 200
    SolveJob.budget_checkpoints = [50, 100, 500, 1000]
