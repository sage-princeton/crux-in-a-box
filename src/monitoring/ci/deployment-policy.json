{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SharedState",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole"
      ],
      "Resource": "arn:aws:iam::869937524494:role/crux-monitoring-state"
    },
    {
      "Sid": "InfrastructureDiscovery",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "batch:Describe*",
        "batch:List*",
        "ecr:GetAuthorizationToken",
        "logs:DescribeLogGroups",
        "cloudwatch:DescribeAlarms",
        "iam:ListRoles",
        "iam:ListInstanceProfiles",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:ListPolicyVersions",
        "kms:ListAliases",
        "kms:ListKeys"
      ],
      "Resource": "*"
    },
    {
      "Sid": "MonitoringResources",
      "Effect": "Allow",
      "Action": [
        "batch:*",
        "ecr:*",
        "scheduler:*",
        "events:*",
        "sqs:*",
        "logs:*",
        "cloudwatch:*",
        "iam:*",
        "s3:*"
      ],
      "Resource": [
        "arn:aws:batch:us-east-1:881004720495:*/crux-monitoring-ae211*",
        "arn:aws:ecr:us-east-1:881004720495:repository/crux-monitoring-ae211",
        "arn:aws:scheduler:us-east-1:881004720495:schedule/crux-monitoring-ae211*/*",
        "arn:aws:scheduler:us-east-1:881004720495:schedule-group/crux-monitoring-ae211*",
        "arn:aws:events:us-east-1:881004720495:rule/crux-monitoring-ae211*",
        "arn:aws:sqs:us-east-1:881004720495:crux-monitoring-ae211*",
        "arn:aws:logs:us-east-1:881004720495:log-group:/crux/monitoring/crux-monitoring-ae211*",
        "arn:aws:cloudwatch:us-east-1:881004720495:alarm:crux-monitoring-ae211*",
        "arn:aws:iam::881004720495:role/crux-monitoring-ae211*",
        "arn:aws:iam::881004720495:role/crux-incident-web",
        "arn:aws:iam::881004720495:instance-profile/crux-monitoring-ae211*",
        "arn:aws:iam::881004720495:instance-profile/crux-incident-web",
        "arn:aws:s3:::crux-monitoring-ae211-881004720495-us-east-1",
        "arn:aws:s3:::crux-monitoring-ae211-881004720495-us-east-1/*",
        "arn:aws:s3:::crux-monitoring-ae211-881004720495-us-east-1-access",
        "arn:aws:s3:::crux-monitoring-ae211-881004720495-us-east-1-access/*"
      ]
    },
    {
      "Sid": "MonitoringTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:CreateTable",
        "dynamodb:UpdateTable",
        "dynamodb:DeleteTable",
        "dynamodb:Describe*",
        "dynamodb:ListTagsOfResource",
        "dynamodb:TagResource",
        "dynamodb:UntagResource",
        "dynamodb:UpdateTimeToLive",
        "dynamodb:UpdateContinuousBackups"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:881004720495:table/crux-monitoring-ae211*"
    },
    {
      "Sid": "EC2Infrastructure",
      "Effect": "Allow",
      "Action": [
        "ec2:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "CreateMonitoringKeys",
      "Effect": "Allow",
      "Action": [
        "kms:CreateKey",
        "kms:TagResource"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "crux-monitoring",
          "aws:RequestedRegion": "us-east-1"
        }
      }
    },
    {
      "Sid": "ManageMonitoringKeys",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListResourceTags",
        "kms:PutKeyPolicy",
        "kms:EnableKeyRotation",
        "kms:DisableKeyRotation",
        "kms:UpdateKeyDescription",
        "kms:EnableKey",
        "kms:DisableKey",
        "kms:ScheduleKeyDeletion",
        "kms:CancelKeyDeletion",
        "kms:TagResource",
        "kms:UntagResource",
        "kms:CreateGrant",
        "kms:ListGrants",
        "kms:RevokeGrant"
      ],
      "Resource": "arn:aws:kms:us-east-1:881004720495:key/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "crux-monitoring"
        }
      }
    },
    {
      "Sid": "ServiceLinkedRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "batch.amazonaws.com",
            "ecs.amazonaws.com",
            "autoscaling.amazonaws.com",
            "spot.amazonaws.com",
            "spotfleet.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "WebReconciliation",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": "arn:aws:ec2:us-east-1:881004720495:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/CruxRole": "monitoring-web"
        }
      }
    },
    {
      "Sid": "WebCommandDocument",
      "Effect": "Allow",
      "Action": [
        "ssm:SendCommand"
      ],
      "Resource": "arn:aws:ssm:us-east-1::document/AWS-RunShellScript"
    },
    {
      "Sid": "WebCommandStatus",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation"
      ],
      "Resource": "*"
    }
  ]
}
