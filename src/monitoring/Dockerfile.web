FROM python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
WORKDIR /app
COPY requirements.txt web-requirements.txt ./
RUN pip install --no-cache-dir -r web-requirements.txt && useradd --uid 10001 --create-home monitor
COPY review.py lifecycle.py web.py web_auth.py ./
COPY prompts ./prompts
COPY templates ./templates
COPY static ./static
USER 10001
CMD ["gunicorn", "--bind", "127.0.0.1:8080", "--workers", "2", "--timeout", "30", "--access-logfile", "-", "web:create_app()"]
