# Copy to placeholders-run.txt and fill in the workspace settings.
# Keep the provider key and workspace token in run-secrets-<slug>.json.
# Shared Langfuse keys belong in SSM /crux/system/env; upload with --put-system-secrets.

# AWS region. Leave AWS_PROFILE empty to use ambient environment credentials
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN).
AWS_PROFILE=
AWS_REGION=us-east-1

# Slug for this run box. Used verbatim as the EC2 Name tag, the ~/.ssh/config
# alias, AND the Langfuse `environment` — one id across AWS and OTel, so a
# trace can be traced back to the box that made it.
RUN_SLUG=crux-codex-1

# The control box to dial. Must be the PRIVATE DNS name: run boxes reach
# AgentRQ over the VPC, and a public address would not match the security
# group rule. make-control-box.sh prints this.
CONTROL_PRIVATE_DNS=ip-172-31-13-27.ec2.internal

# Where the box dials its workspace. REQUIRED: use the control box's
# public HTTPS hostname; provisioning pins it to the control box's private IP.
#
# If the control box has HTTPS on (TLS_ENABLED=1), this MUST be its public
# https base — e.g. https://32-195-122-118.sslip.io. AgentRQ ROUTES BY HOST:
# once AGENTRQ_DOMAIN is the public hostname, a request arriving on the
# private name gets a flat 404 with nothing in the logs to explain it. Dialling
# the public name also stops the workspace token, which rides in the URL query
# string, from crossing the VPC in plaintext.
CONTROL_MCP_BASE=https://<dashed-eip>.sslip.io

# Break-glass SSH. Same comma-separated, optionally labelled form as the
# control box (CIDR=LABEL, every entry a /32) — though the rules themselves are
# created by make-control-box.sh, which owns crux-run-sg's ingress. This script
# only checks the shape. A run box needs no inbound to do its job.
# Find yours with: curl -s https://checkip.amazonaws.com
OPERATOR_CIDR=203.0.113.10/32

# Opt in, per resource type, to grant this run's agent scoped AWS access to
# provision that resource in a separate, pre-existing isolated AWS account
# (self-hosting devops pilot — see docs/superpowers/specs/2026-09-20-aux-aws-resources-design.md
# in a local checkout; the spec itself is not committed). All default off.
# AUX_RESOURCE_PROFILE names the AWS CLI profile for the isolated account.
# provision-aux-aws-resources.sh writes AUX_RESOURCE_ACCOUNT_ID and
# AUX_RESOURCE_ROLE_ARN below this block once it has run.
PROVISION_POSTGRES=
PROVISION_S3=
PROVISION_DNS=
PROVISION_EC2=
PROVISION_CLOUDFRONT=
PROVISION_ACM=
AUX_RESOURCE_PROFILE=

# EC2 instance and disk size. ROOT_IOPS and ROOT_THROUGHPUT default to 6000 and 250.
INSTANCE_TYPE=t3.2xlarge
ROOT_DISK_GB=80

# EC2 key pair. Shared with the control box by default.
KEY_NAME=crux-acp

# Agent settings. Model and effort are required for the selected platform.
# Codex effort: minimal | low | medium | high. An omitted platform selects Codex.
AGENT_PLATFORM=codex

# For Claude, set AGENT_PLATFORM=claude and fill in these instead of CODEX_*:
# CLAUDE_MODEL=<explicit-model-id>
# CLAUDE_EFFORT=high
# Claude effort: low | medium | high | xhigh | max.
# Model support for effort levels varies; the probe checks model availability.
CLAUDE_VERSION=2.1.272
CLAUDE_ACP_VERSION=0.77.0

CODEX_MODEL=gpt-5.5
CODEX_REASONING_EFFORT=high

# Pinned CLI and adapter versions; installation replaces mismatched versions.
CODEX_VERSION=0.154.0
CODEX_ACP_VERSION=1.10.0
ACP_GATEWAY_VERSION=0.2.17

# Codex tracing plugin and Stop-hook trust hash.
# When changing the plugin version, accept its hook interactively and copy
# trusted_hash from ~/.codex/config.toml. Provisioning checks that the hook runs.
TRACING_PLUGIN_VERSION=0.3.0
TRACING_HOOK_TRUSTED_HASH=sha256:69a05cbfa6984ec5f1433343b45480d5239c119e7332ae863f9865edc2efec74
