# Copy to placeholders-base.txt and set the shared AWS, controller and agent values.
# Omit RUN_SLUG; make-new-workspace.sh writes per-workspace values.
# Keep the provider key in run-secrets-base.json and shared Langfuse keys in
# SSM /crux/system/env. Upload them with --put-system-secrets.

# AWS region. Leave AWS_PROFILE empty to use ambient environment credentials
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN).
AWS_PROFILE=
AWS_REGION=us-east-1


# Controller private DNS hint; provisioning checks it against the live instance.
CONTROL_PRIVATE_DNS=ip-x-x-x-x.ec2.internal

# Controller HTTPS URL. Its hostname must match AGENTRQ_DOMAIN.
CONTROL_MCP_BASE=https://<dashed-eip>.sslip.io


# EC2 instance and disk size. ROOT_IOPS and ROOT_THROUGHPUT default to 6000 and 250.
INSTANCE_TYPE=t3.2xlarge
ROOT_DISK_GB=80
# Set false for test boxes when Elastic IP quota is exhausted. The ordinary
# public IP changes after stop/start; rerun provisioning to refresh the SSH alias.
USE_ELASTIC_IP=true

# EC2 key pair. Shared with the control box by default.
KEY_NAME=crux-acp

# Optional: reuse an existing Elastic IP instead of allocating a fresh one
# tagged to RUN_SLUG. Useful when this address is allowlisted elsewhere (e.g.
# by a web host to avoid crawl rate-limiting) and needs to stay stable across
# workspaces. Give its public IP, not its allocation id — provisioning looks
# that up. teardown-workspace-aws-resources.sh never releases it when set.
# Allocate one with utils/manage-elastic-ips.sh create --name <name>.
ELASTIC_IP_ADDRESS=34.201.10.20

# Agent settings. Model and effort are required for the selected platform.
# Codex effort: none | low | medium | high | xhigh | max. An omitted platform
# selects Codex. Support varies by model; see the effort table in agent-config.sh.
AGENT_PLATFORM=codex

# Optional gateway: direct (default) | openrouter. OpenRouter requires an
# OPENROUTER_API_KEY in the secrets file and a full model ID such as
# google/gemini-3.5-flash in the selected platform's model key.
MODEL_PROVIDER=direct

# For Claude, set AGENT_PLATFORM=claude and fill in these instead of CODEX_*:
# CLAUDE_MODEL=<explicit-model-id>
# CLAUDE_EFFORT=high
# Claude effort: low | medium | high | xhigh | max.
# Support varies by model; see the effort table in agent-config.sh.
CLAUDE_VERSION=2.1.272
CLAUDE_ACP_VERSION=0.77.0

# For the SDK scaffold (src/sdk-scaffold), set AGENT_PLATFORM=openai-agents and:
# OPENAI_AGENTS_MODEL=<explicit-model-id>
# OPENAI_AGENTS_REASONING_EFFORT=medium
# Effort: none | low | medium | high | xhigh | max, checked per model like Codex.
# MODEL_PROVIDER must stay direct. It
# needs no AgentRQ workspace, control box settings or CLI/ACP pins.

# The drop-in directory staged at /srv/crux-run/run-harness, as a repo-relative
# path. Default: run-harness. openai-agents needs one with a scaffold.toml,
# e.g. src/sdk-scaffold/examples/web-cms-product-change.
# DROP_IN_PATH=run-harness
# Optional: commit provision.json alongside the drop-in's scaffold.toml to
# declare run-specific OS packages, pinned CLI downloads and command checks.
# See provisioning.md. No declaration means no additional software.

CODEX_MODEL=
CODEX_REASONING_EFFORT=

# Pinned CLI and adapter versions; installation replaces mismatched versions.
CODEX_VERSION=0.154.0
CODEX_ACP_VERSION=1.10.0
# Native ACP v1 requires the matching controller upgrade; see ec2-control/README.md.
# Provisioning verifies the upstream npm tarball's version and SHA-256.
ACP_GATEWAY_VERSION=0.4.1
ACP_GATEWAY_TARBALL_URL=https://registry.npmjs.org/@agentrq/acp-gateway/-/acp-gateway-0.4.1.tgz
ACP_GATEWAY_SHA256=00914fa6b0762a44ea6f5c99f2b92e2c05887a67f631d63c6a9c22d7cf1acf11

# Codex tracing plugin and Stop-hook trust hash. Provisioning installs npm
# @langfuse/codex-observability-plugin@$TRACING_PLUGIN_VERSION. The hash covers the
# plugin's hooks/hooks.json entry, not its code, so it only changes when that file
# does. When changing the plugin version, accept its hook interactively and copy
# trusted_hash from ~/.codex/config.toml. Provisioning checks that the hook runs.
TRACING_PLUGIN_VERSION=0.4.0
TRACING_HOOK_TRUSTED_HASH=sha256:69a05cbfa6984ec5f1433343b45480d5239c119e7332ae863f9865edc2efec74

# Optional, Codex only: how turns reach Langfuse. live (the default) disables
# the plugin's Stop hook and runs crux-codex-live-trace, which sends reasoning
# summaries, each tool call and model response within about 30s, and the turn's
# root (input and output) when it ends. Codex's model_reasoning_summary = "auto"
# setting selects the most detailed summarizer available for the model.
# stop-hook uses the plugin's Stop hook and does not export reasoning summaries.
CODEX_TRACE_MODE=live

# The control box's ssh alias, used to mint workspaces.
CONTROL_SSH_ALIAS=crux-control

# Opt in, per resource type, to grant this run's agent scoped AWS access to
# provision that resource in a separate, pre-existing isolated AWS account
# (self-hosting devops pilot — see docs/superpowers/specs/2026-09-20-aux-aws-resources-design.md
# in a local checkout; the spec itself is not committed). All default off.
# With both PROVISION_EC2 and PROVISION_S3 set, the agent may also give its
# own EC2 instances an IAM role (crux-app-* only, capped by a
# crux-app-boundary permissions boundary the agent cannot alter or remove).
# AUX_RESOURCE_PROFILE names the AWS CLI profile for the isolated account.
# provision-aux-aws-resources.sh writes AUX_RESOURCE_ACCOUNT_ID and
# AUX_RESOURCE_ROLE_ARN below this block once it has run.
PROVISION_POSTGRES=
PROVISION_S3=
PROVISION_DNS=
PROVISION_EC2=
PROVISION_CLOUDFRONT=
PROVISION_ACM=
AUX_RESOURCE_PROFILE=
