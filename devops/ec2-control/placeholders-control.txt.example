# Copy to placeholders-control.txt. Keep secrets in the AgentRQ environment
# file and upload it to SSM with make-control-box.sh --put-secrets <envfile>.

# AWS profile and region. The profile must be authenticated
# (aws sso login --sso-session <session>) before running.
AWS_PROFILE=crux
AWS_REGION=us-east-1

# Slug for the control box. Used verbatim as the EC2 Name tag and the
# ~/.ssh/config alias.
CONTROL_SLUG=crux-control

# SSH access: comma-separated /32 addresses, optionally CIDR=LABEL.
# Labels become AWS rule descriptions. Find the current address with:
#   curl -s https://checkip.amazonaws.com
OPERATOR_CIDR=203.0.113.10/32=me

# EC2 shape. AgentRQ is a Go binary plus SQLite; the agents run elsewhere.
INSTANCE_TYPE=t3.small
ROOT_DISK_GB=20

# Separate EBS volume for AgentRQ state, mounted at /srv/agentrq so the
# control plane survives instance replacement.
DATA_DISK_GB=20

# EC2 key pair. Created if absent; the private key lands in ~/.ssh/<name>.pem.
KEY_NAME=crux-acp

# HTTPS via Caddy and Let's Encrypt is required.

# Certificate hostname. Leave empty for <dashed-ip>.sslip.io.
# For a custom hostname, point its A record at the Elastic IP before provisioning.
TLS_HOSTNAME=

# Optional Let's Encrypt contact email.
TLS_EMAIL=

# HTTPS access: comma-separated CIDR=LABEL entries; ranges are permitted.
# Port 80 remains public for certificate validation and renewal.
TLS_INGRESS_CIDR=203.0.113.10/32
