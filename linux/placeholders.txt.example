# placeholders.txt — single config file for create-new-crux-box.sh
#
# Usage: ./create-new-crux-box.sh --ami <AMI_ID> placeholders.txt
#   (placeholders.txt is also the default if no argument is given)
#   Flags: --ami <AMI_ID> (pre-baked AMI from build-ami.sh — skips the software
#   install; omit to run the full install on raw Ubuntu) and
#   --instance-suffix <SUFFIX> (run multiple instances in parallel,
#   e.g. ./create-new-crux-box.sh --instance-suffix 2 placeholders.txt).
#
# Lines are KEY=VALUE. Comments (#) and blank lines are ignored.
# All configuration lives here. create-new-crux-box.sh validates that every
# Required key below is present and non-blank BEFORE doing any AWS work, and
# lists all missing keys at once.

# ── Required: provisioning / runtime (used by create-new-crux-box.sh itself) ──

TELEGRAM_BOT_NAME=your-bot-name          # must exist as a key in telegram_bots.json
TELEGRAM_OWNER_ID=123456789              # your Telegram user ID

DEFAULT_LLM_MODEL=anthropic/claude-opus-4-8   # or e.g. openai/gpt-4o for an OpenAI run
REASONING_EFFORT=xhigh                        # enables extended thinking.
                                              # accepted: off|minimal|low|medium|high|xhigh|adaptive|max
# Set exactly one of ANTHROPIC_API_KEY or OPENAI_API_KEY (secrets — keep this file out of git):
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
COST_TRACKER_URL=https://xxxx.execute-api.us-east-1.amazonaws.com/cost
RUNPOD_API_KEY=rp-...                    # secret — written to ~/.openclaw/.env
REFINE_INK_API_KEY=...                   # secret — written to ~/.openclaw/.env
OPENROUTER_API_KEY=sk-or-v1-...          # secret — written to ~/.openclaw/.env (the experiments' LLM calls; create a dedicated key with its credit limit = OPENROUTER_BUDGET)

# ── Required: workspace placeholders (no defaults — substituted into files) ──

CLOUD_SPEND_LIMIT=$500
OPENROUTER_BUDGET=$500
API_BUDGET=$2000
DEADLINE=10 days from launch            # (falls back to "two weeks from launch" if omitted)

# The task itself — the run-specific brief. These are substituted into
# AGENTS.md (a generic template; the actual research goal lives here, in
# config). Each is a single line (the config format is one KEY=VALUE per
# line). Avoid '#' (treated as a comment) and '&' in the values.
RESEARCH_QUESTION=<the one-sentence research question the agent must answer>
RESEARCH_CONTEXT=<the background the agent needs, plus exactly what to produce — e.g. "Prior methods do A but not B, and existing approaches are brittle. The agent should produce (a) a method for B, (b) evidence about whether the result is robust/composable, and (c) at least one downstream test it did not directly optimize for.">


# ── Required: gog (Google Workspace CLI) auto-config ──
# All three are required. First create the bundle once on your laptop:
#     GOG_KEYRING_PASSWORD=... utils/bootstrap-gog.sh client_secret.json you@gmail.com
# Then point GOG_HOME_TARBALL at the resulting gog-home.tar.gz. These are
# SECRETS (the tarball holds a live Gmail refresh token) — keep them out of git.
GOG_ACCOUNT=you@gmail.com
GOG_KEYRING_PASSWORD=the-same-passphrase-used-in-bootstrap-gog.sh
GOG_HOME_TARBALL=./gog-home.tar.gz

# ── Optional: workspace placeholders with defaults (uncomment to override) ──

# PAGE_BUDGET=9
# BACKMATTER_ALLOWANCE=15    # extra pages allowed for references/appendices (gate_artifact.sh)
# ABSTRACT_WORD_CAP=200      # final-pass gate: max abstract words (gate_artifact.sh)
# PYTHON_SETUP=uv + a pinned 3.11+ venv under code/; system python is old
# HOST_DESCRIPTION=Ubuntu 22.04 EC2, amd64
# SNAPSHOT_TIMES=10:00 and 19:00
# LEDGER_BEAT_HOURS=6          # cadence of the agent's scheduled ledger/reflection beat (AGENTS.md § Your budget)
# VENUE=NeurIPS
# DELIVERABLE_TOOLCHAIN=LaTeX via tectonic + the venue template at templates/paper_template.zip — unzip into paper/ and build the skeleton on day 1

# ── Optional: provisioning knobs with defaults (uncomment to override) ──
# Same {{KEY|default}} grammar, but consumed by configure.sh itself (openclaw.json,
# the installed watchdog scripts, crontab) rather than substituted into the
# workspace files. Positive integers only.

# TELEMETRY_ROTATE_MAX_BYTES=104857600   # telemetry.jsonl rotates at this size (100 MiB); rotated files are telemetry.jsonl.N.gz — collect telemetry.jsonl*
# TELEMETRY_ROTATE_MAX_FILES=50          # rotated telemetry files kept before the oldest is dropped (50 × 100 MiB ≈ 5 GB uncompressed ceiling)
# AUTH_WATCHDOG_THRESHOLD=4              # consecutive auth-class failed turns (revoked key / permission / credit) before crux-auth-watchdog stops the gateway and pages you; at the 15m heartbeat cadence 4 ≈ 1 h of dead turns
# SESSION_SNAPSHOT_MINUTES=10            # cadence (1–59) of the session-store snapshot cron that keeps cron transcripts + orphaned main generations under ~/.openclaw/session-snapshots/
