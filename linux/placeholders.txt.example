# placeholders.txt — single config file for setup-device.sh
#
# Usage: ./setup-device.sh placeholders.txt
#   (placeholders.txt is also the default if no argument is given)
#   The only command-line flag is --instance-suffix <SUFFIX> (run multiple
#   instances in parallel, e.g. ./setup-device.sh --instance-suffix 2 placeholders.txt).
#
# Lines are KEY=VALUE. Comments (#) and blank lines are ignored.
# All configuration lives here. setup-device.sh validates that every Required
# key below is present and non-blank BEFORE doing any AWS work, and lists all
# missing keys at once.

# ── Required: provisioning / runtime (used by setup-device.sh itself) ──

TELEGRAM_BOT_NAME=your-bot-name          # must exist as a key in telegram_bots.json
TELEGRAM_OWNER_ID=123456789              # your Telegram user ID
# Optional: pre-built CRUX base AMI. When set, setup-device.sh skips the 10-15 min
# apt/openclaw install and runs only configure.sh (~60-90s). Build with:
#   cd linux && ./build-ami.sh
# Leave blank (or omit) to install from a raw Ubuntu 22.04 instance as before.
# CRUX_AMI_ID=ami-...

DEFAULT_LLM_MODEL=anthropic/claude-opus-4-8   # or e.g. openai/gpt-4o for an OpenAI run
REASONING_EFFORT=xhigh                        # enables extended thinking.
                                              # accepted: off|minimal|low|medium|high|xhigh|adaptive|max
# Set exactly one of ANTHROPIC_API_KEY or OPENAI_API_KEY (secrets — keep this file out of git):
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
COST_TRACKER_URL=https://xxxx.execute-api.us-east-1.amazonaws.com/cost
RUNPOD_API_KEY=rp-...                    # secret — written to ~/.openclaw/.env
REFINE_INK_API_KEY=...                   # secret — written to ~/.openclaw/.env
# GitHub classic PAT — secret. Authenticates the gh CLI + git-over-HTTPS on the
# box (gh auth login --with-token) and is written to ~/.openclaw/.env as
# GITHUB_TOKEN/GH_TOKEN. Create at https://github.com/settings/tokens (classic);
# needs at least 'repo' scope (add 'workflow' if the agent edits CI).
GITHUB_CLASSIC_PERSONAL_ACCESS_TOKEN=ghp_...

# ── Required: workspace placeholders (no defaults — substituted into files) ──

GITHUB_USER=your-github-username
CLOUD_SPEND_LIMIT=$500
API_BUDGET=$2000
DEADLINE=10 days from launch

# The task itself — the run-specific brief. These are substituted into BRIEF.md
# (which is a generic template; the actual research goal lives here, in config).
# Each is a single line (the config format is one KEY=VALUE per line). Avoid '#'
# (treated as a comment) and '&' in the values.
RESEARCH_QUESTION=<the one-sentence research question the agent must answer>
RESEARCH_CONTEXT=<the background the agent needs, plus exactly what to produce — e.g. "Prior methods do A but not B, and existing approaches are brittle. The agent should produce (a) a method for B, (b) evidence about whether the result is robust/composable, and (c) at least one downstream test it did not directly optimize for.">


# ── Required: gog (Google Workspace CLI) auto-config ──
# All three are required. First create the bundle once on your laptop:
#     GOG_KEYRING_PASSWORD=... utils/bootstrap-gog.sh client_secret.json you@gmail.com
# Then point GOG_HOME_TARBALL at the resulting gog-home.tar.gz. These are
# SECRETS (the tarball holds a live Gmail refresh token) — keep them out of git.
GOG_ACCOUNT=you@gmail.com
GOG_KEYRING_PASSWORD=the-same-passphrase-used-in-bootstrap-gog.sh
GOG_HOME_TARBALL=./gog-home.tar.gz

# ── Optional: workspace placeholders with defaults (uncomment to override) ──

# PAGE_BUDGET=9
# ABSTRACT_WORD_CAP=200      # presentation gate: max abstract words (gate_artifact.sh)
# SNAPSHOT_TIMES=10:00 and 19:00
# VENUE=NeurIPS
# PREFLIGHT_COST=50
# PREFLIGHT_HOURS=6
# DELIVERABLE_TOOLCHAIN=LaTeX via tectonic + venue template — installed and building from day 1, see PLAN.md milestone 1
# EXTERNAL_REVIEWER_ACCESS=platform → how to submit → quota, one line each
# EXTERNAL_REVIEWERS=e.g. Stanford agentic reviewer; CMU paper reviewer; refine.ink
